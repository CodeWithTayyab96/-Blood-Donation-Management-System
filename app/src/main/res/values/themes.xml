<?xml version="1.0" encoding="utf-8"?>
<!--
  Warm Clinical Sanguine theme (Stitch, 2026-11-07). Light-first Material theme.
  DayNight parent is kept, but no values-night resources exist, so the app
  deliberately stays in this light palette even in system dark mode.
-->
<resources>
    <style name="Theme.BloodDonation" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_primary_container</item>
        <item name="colorSecondaryVariant">@color/rose_tint</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/warm_surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorBackground">@color/warm_background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/warm_background</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/warm_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.Blood.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Blood.Button.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.Blood.FAB</item>
        <!-- Both forms: framework widgets read android:*, AppCompat widgets read the unprefixed attr. -->
        <item name="android:editTextStyle">@style/Widget.Blood.EditText</item>
        <item name="editTextStyle">@style/Widget.Blood.EditText</item>
        <item name="android:spinnerStyle">@style/Widget.Blood.Spinner</item>
        <item name="spinnerStyle">@style/Widget.Blood.Spinner</item>
    </style>
</resources>
