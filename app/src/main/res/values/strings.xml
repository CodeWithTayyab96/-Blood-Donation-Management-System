    <!-- Shared safety / disclaimer text -->
    <string name="safety_request_detail">Safety: this app cannot verify blood groups, identity or health. Everything here is self-reported. Never pay for blood, and meet only at a hospital or registered blood bank.</string>
    <string name="hint_register_phone">Phone number *</string>
    <string name="safety_ask_donate_top">⚠️ General information only — NOT medical advice. Every blood bank has its own screening rules, and only their health check can actually decide. Never send personal details such as your phone number or patient names here.</string>
    <string name="safety_ask_donate_bottom">Donation must take place at a licensed blood bank or hospital. Nothing personal leaves this phone — the app does not send your name, phone number, patient names or donor history, and the AI answer is general information only.</string>
    <string name="safety_create_request">Requests are public to signed-in donors. Your contact number is shown to them so they can reach you. Only share what you are comfortable sharing.</string>
    <string name="safety_profile_availability">Available donors can offer to help on nearby requests. Your phone number is shared with a requester only after you both accept.</string>
    <string name="safety_login_subtitle">Sign in with the email address and password of your account. There is no offline demo login any more.</string>
    <string name="safety_login_secondary">Managers can manage all donors, stock and requests. Donors can view everything but only edit their own profile and donations.</string>

