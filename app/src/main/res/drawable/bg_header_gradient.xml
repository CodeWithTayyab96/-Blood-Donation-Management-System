<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand header background: a diagonal red gradient with rounded bottom
    corners, used for the header band on the home screens. Fixed brand
    colours are fine here in both light and dark mode (white text on red).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/blood_red"
        android:endColor="@color/blood_red_dark"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
