<?xml version="1.0" encoding="utf-8"?>
<!-- Settings. Warm Clinical Sanguine restyle (2026-11-07): each section in a
     white card (Widget.Blood.Card); delete-account action stays Danger. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <!-- Theme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_theme_heading" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text_accent" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_theme_summary" android:textSize="13sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />

                <!-- The choice applies at once: AppCompatDelegate recreates the activities. -->
                <RadioGroup android:id="@+id/rgTheme"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbThemeLight"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_theme_light"
                        android:textSize="16sp" android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbThemeDark"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_theme_dark"
                        android:textSize="16sp" android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbThemeSystem"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_theme_system"
                        android:textSize="16sp" android:textColor="@color/on_surface" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_language_heading" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text_accent" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_language_summary" android:textSize="13sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />

                <!-- start/end padding only: this row mirrors correctly in Urdu (RTL). -->
                <RadioGroup android:id="@+id/rgLanguage"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <RadioButton android:id="@+id/rbEnglish"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_language_english"
                        android:textSize="16sp" android:textColor="@color/on_surface" />
                    <RadioButton android:id="@+id/rbUrdu"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/settings_language_urdu"
                        android:textSize="16sp" android:textColor="@color/on_surface" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notifications -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_notifications_heading" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text_accent" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swTips"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_tip_switch"
                    android:textSize="16sp" android:textColor="@color/on_surface" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_tip_summary"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <TextView android:id="@+id/tvNotificationState"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="18dp" />

                <Button android:id="@+id/btnNotificationSettings"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_open_android_notification_settings"
                    android:layout_marginTop="8dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_alert_note"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="18dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_reminder_heading" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text_accent"
                    android:layout_marginTop="20dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_reminder_summary"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Connection -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_connection_heading" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/text_accent" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_connection_summary"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <Button android:id="@+id/btnConnectionCheck"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_run_connection_check"
                    android:layout_marginTop="8dp"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Account -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/settings_account_heading" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/status_bad" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/settings_delete_summary"
                    android:textSize="13sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <Button android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/label_delete_account"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.Blood.Button.Danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
