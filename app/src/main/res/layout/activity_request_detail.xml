<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:id="@+id/syncRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="8dp" android:visibility="gone">
            <ProgressBar android:id="@+id/progressSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleSmall" android:indeterminate="true" />
            <TextView android:id="@+id/syncLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>
        <TextView android:id="@+id/tvReqDetailTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_accent" />
        <TextView android:id="@+id/tvReqDetailInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:lineSpacingMultiplier="1.4" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/tvSafety" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="10dp"
            android:text="@string/safety_request_detail" />

        <!-- Only shown when this account is allowed to see a usable contact
             number. Uses start/end so the row mirrors in Urdu (RTL). -->
        <LinearLayout android:id="@+id/contactActions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp"
            android:visibility="gone">
            <Button android:id="@+id/btnCall"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/label_call"
                style="?attr/materialButtonOutlinedStyle" />
            <Button android:id="@+id/btnWhatsApp"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:text="@string/label_whatsapp"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <Button android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_share" android:layout_marginTop="8dp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button android:id="@+id/btnFulfill" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_fulfill_stock" android:layout_marginTop="14dp" />

        <Button android:id="@+id/btnOffer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_i_can_donate" android:layout_marginTop="14dp" android:visibility="gone" />
        <TextView android:id="@+id/tvOfferState" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="10dp" android:visibility="gone" />

        <TextView android:id="@+id/tvOffersHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/hint_offers_header" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="20dp" android:layout_marginBottom="6dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/offersContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />

        <Button android:id="@+id/btnComplete" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_donation_completed" android:layout_marginTop="14dp" android:visibility="gone" />

        <Button android:id="@+id/btnReport" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_report_request" android:layout_marginTop="10dp" android:visibility="gone" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/hint_compatible_donors" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="20dp" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/tvCompatNote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginBottom="6dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCompatDonors"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
