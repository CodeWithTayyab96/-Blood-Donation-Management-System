<?xml version="1.0" encoding="utf-8"?>
<!--
    "Can I donate?" helper (Phase 4). Deliberately plain: one visible
    disclaimer up top, one question box, one answer. The AI answer is general
    information only — the safety notes at the bottom stay visible no matter
    what the model produces.
    Warm Clinical Sanguine restyle (2026-11-07).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Can I donate? (AI helper)" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:text="@string/safety_ask_donate_top" />

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:hint="Ask something general, e.g. whether common medicines affect donating"
            android:inputType="textMultiLine|textCapSentences"
            android:lines="4" android:maxLength="500" android:maxLines="6" />

        <!-- Small spinner beside the Ask button while the AI answer is fetched. -->
        <LinearLayout
            android:id="@+id/syncRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="8dp" android:visibility="gone">
            <ProgressBar android:id="@+id/progressSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleSmall" android:indeterminate="true"
                android:indeterminateTint="@color/brand_primary_container" />
            <TextView android:id="@+id/syncLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAskVerify"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Ask" />

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textIsSelectable="true"
            android:textSize="15sp" android:textColor="@color/on_surface"
            android:background="@drawable/bg_input" android:padding="16dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="@string/safety_ask_donate_bottom" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="@string/safety_ask_donate_note" />

    </LinearLayout>
</ScrollView>
