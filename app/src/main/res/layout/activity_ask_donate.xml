<?xml version="1.0" encoding="utf-8"?>
<!--
    "Can I donate?" helper (Phase 4). Deliberately plain: one visible
    disclaimer up top, one question box, one answer. The AI answer is general
    information only — the safety notes at the bottom stay visible no matter
    what the model produces.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🩸 Can I donate?" android:textSize="22sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:textSize="13sp"
            android:text="⚠️ General information only — NOT medical advice. Every blood bank has its own screening rules, and only their health check can actually decide. Never send personal details such as your phone number or patient names here." />

        <EditText
            android:id="@+id/etQuestion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:hint="Ask something general, e.g. whether common medicines affect donating"
            android:inputType="textMultiLine|textCapSentences"
            android:lines="4" android:maxLength="500" android:maxLines="6" />

        <!-- Small spinner beside the Ask button while the AI answer is fetched. -->
        <LinearLayout
            android:id="@+id/syncRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="8dp" android:visibility="gone">
            <ProgressBar android:id="@+id/progressSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleSmall" android:indeterminate="true" />
            <TextView android:id="@+id/syncLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAskVerify"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Ask" />

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textIsSelectable="true"
            android:textSize="15sp" android:visibility="gone" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:textSize="12sp"
            android:text="Donation must take place at a licensed blood bank or hospital. Your own history in this app is not sent: only your first name, donation count, days since your last donation and blood group are sent as context, and nothing is stored." />

    </LinearLayout>
</ScrollView>
