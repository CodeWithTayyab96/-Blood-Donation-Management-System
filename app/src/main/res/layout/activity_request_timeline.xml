<?xml version="1.0" encoding="utf-8"?>
<!-- Request status timeline. Warm Clinical Sanguine restyle (2026-11-07). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <ProgressBar android:id="@+id/progressTimeline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:indeterminate="true" android:visibility="gone"
            android:indeterminateTint="@color/brand_primary_container"
            style="?android:attr/progressBarStyleSmall" />

        <TextView android:id="@+id/tvTimelineTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/timeline_title" android:textSize="22sp"
            android:textStyle="bold" android:textColor="@color/on_surface" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/timeline_note" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <TextView android:id="@+id/tvTimeline"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textColor="@color/on_surface"
                android:lineSpacingMultiplier="1.4" android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
