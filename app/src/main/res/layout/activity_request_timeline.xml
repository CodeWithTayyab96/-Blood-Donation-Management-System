<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <ProgressBar android:id="@+id/progressTimeline"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:indeterminate="true" android:visibility="gone"
            style="?android:attr/progressBarStyleSmall" />

        <TextView android:id="@+id/tvTimelineTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/timeline_title" android:textSize="20sp"
            android:textStyle="bold" android:textColor="@color/text_accent" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/timeline_note" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />

        <TextView android:id="@+id/tvTimeline"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
