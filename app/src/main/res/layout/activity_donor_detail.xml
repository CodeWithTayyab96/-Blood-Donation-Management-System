<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvDetailName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="24sp" android:textStyle="bold" android:textColor="@color/blood_red_dark" />
        <TextView android:id="@+id/tvDetailInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:lineSpacingMultiplier="1.4" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/tvDetailEligibility" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnRecordDonation" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🩸 Record Donation (1 unit)" android:layout_marginTop="14dp" />
        <Button android:id="@+id/btnDeleteDonor" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Delete Donor" android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Donation history" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="20dp" android:layout_marginBottom="6dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHistory"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvNoHistory" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No donations recorded yet." android:textColor="@color/grey_text" />
    </LinearLayout>
</ScrollView>
