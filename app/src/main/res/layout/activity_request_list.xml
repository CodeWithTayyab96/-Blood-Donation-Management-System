<?xml version="1.0" encoding="utf-8"?>
<!-- Blood requests list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/warm_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Blood Requests" android:textAppearance="@style/TextAppearance.Blood.Headline"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Track and fulfil patient requests"
        android:textAppearance="@style/TextAppearance.Blood.Secondary"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp" />

    <!-- P2P: the donor sees two views. Managers see every request and get no
         tabs (a manager request is fulfilled from stock, not offered on). -->
    <LinearLayout android:id="@+id/tabsRow" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="12dp">
        <Button android:id="@+id/btnTabBrowse" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Browse" android:textSize="13sp" />
        <Button android:id="@+id/btnTabMine" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="My requests" android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRequests"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:clipToPadding="false"
        android:paddingBottom="8dp" />
    <TextView android:id="@+id/tvEmptyRequests" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No requests yet." android:gravity="center" android:padding="24dp"
        android:visibility="gone" android:textSize="15sp"
        android:textColor="@color/text_secondary" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRequest" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_margin="16dp" android:contentDescription="Add request"
        app:srcCompat="@android:drawable/ic_input_add" />

    <!-- In-flight sync indicator: shown while requests/offers are pulled. -->
    <LinearLayout android:id="@+id/syncRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="8dp" android:visibility="gone">
        <ProgressBar android:id="@+id/progressSync"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="?android:attr/progressBarStyleSmall" android:indeterminate="true" />
        <TextView android:id="@+id/syncLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="14sp"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
</LinearLayout>
