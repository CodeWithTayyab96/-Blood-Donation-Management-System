<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRequests"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/tvEmptyRequests" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No requests yet." android:gravity="center" android:padding="24dp"
        android:visibility="gone" android:textSize="15sp" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRequest" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_margin="16dp" android:contentDescription="Add request"
        app:srcCompat="@android:drawable/ic_input_add" />
</LinearLayout>
