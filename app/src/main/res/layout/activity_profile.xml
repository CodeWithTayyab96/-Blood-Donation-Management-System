<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/blood_red_dark" />
        <TextView android:id="@+id/tvProfileInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:lineSpacingMultiplier="1.4" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/tvProfileEligibility" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="10dp" />
        <TextView android:id="@+id/tvProfileNext" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:layout_marginTop="6dp" />
        <Button android:id="@+id/btnSyncProfile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Sync profile to Supabase"
            android:visibility="gone" android:layout_marginTop="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Donation history" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="20dp" android:layout_marginBottom="6dp" />
        <!--
            wrap_content inside a ScrollView: the RecyclerView must not try to
            scroll on its own, or the two fight for the gesture. Its full height
            is laid out and the ScrollView does the scrolling.
        -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHistory"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />
        <TextView android:id="@+id/tvNoHistory" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="No donations recorded yet."
            android:textColor="@color/grey_text" />
    </LinearLayout>
</ScrollView>
