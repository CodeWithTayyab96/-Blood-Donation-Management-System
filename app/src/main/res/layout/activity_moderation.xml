<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reports" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvNoReports" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="No reports."
            android:textColor="@color/text_secondary" android:paddingTop="6dp" />
        <LinearLayout android:id="@+id/reportsContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Offers" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginTop="22dp" />
        <TextView android:id="@+id/tvNoOffers" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="No offers."
            android:textColor="@color/text_secondary" android:paddingTop="6dp" />
        <LinearLayout android:id="@+id/offersContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
