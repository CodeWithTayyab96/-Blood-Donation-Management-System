<?xml version="1.0" encoding="utf-8"?>
<!-- Floating "Can I donate?" button, included above the bottom navigation on
     the tab screens (and on the donor home, where there is no bottom bar).
     Wired by BottomNav.setupChatFab; opens the AI helper chat. -->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fabChat"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/chat_fab_desc"
    app:srcCompat="@drawable/ic_chat"
    app:backgroundTint="@color/brand_primary_container" />
