<?xml version="1.0" encoding="utf-8"?>
<!-- Donors list. Search + group/city filters (existing spinners, restyled); donor cards. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Donors" android:textAppearance="@style/TextAppearance.Blood.Headline"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Find and manage registered donors"
        android:textAppearance="@style/TextAppearance.Blood.Secondary"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp" />

    <EditText android:id="@+id/etSearch" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:hint="Search by name or city" android:inputType="text" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Blood group" android:textAppearance="@style/TextAppearance.Blood.Label"
                android:layout_marginBottom="6dp" />
            <Spinner android:id="@+id/spGroupFilter" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="City" android:textAppearance="@style/TextAppearance.Blood.Label"
                android:layout_marginBottom="6dp" />
            <Spinner android:id="@+id/spCityFilter" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Add donor used to be a floating button; it is a full-width button now
         so the floating chat button can sit at the bottom-right. Managers
         only; DonorListActivity hides it for everyone else. -->
    <Button android:id="@+id/btnAddDonor" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/label_add_donor"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvDonors"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:clipToPadding="false"
        android:paddingBottom="88dp" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No donors found." android:gravity="center" android:padding="24dp"
        android:visibility="gone" android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <!-- In-flight sync indicator: shown while donors are pulled or a donor is saved. -->
    <LinearLayout android:id="@+id/syncRow"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="8dp" android:visibility="gone">
        <ProgressBar android:id="@+id/progressSync"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="?android:attr/progressBarStyleSmall" android:indeterminate="true" />
        <TextView android:id="@+id/syncLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="14sp"
            android:textColor="?android:textColorSecondary" />
    </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation + floating chat button (v1.22). -->
    <include layout="@layout/bottom_nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
    <include layout="@layout/chat_fab"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="72dp" android:layout_marginEnd="16dp" />
</FrameLayout>
