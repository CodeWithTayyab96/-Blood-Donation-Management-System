<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🩸 Blood Donation Management" android:textSize="22sp"
            android:textStyle="bold" android:textColor="@color/text_accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sign in to continue" android:textSize="15sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />
        <EditText android:id="@+id/etUsername" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Email or username *"
            android:inputType="text" android:autofillHints="username" />
        <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Password *"
            android:inputType="textPassword" android:autofillHints="password" />
        <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Sign In"
            android:layout_marginTop="16dp" />
        <Button android:id="@+id/btnRegister" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Register as a Donor"
            android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Demo manager: manager / manager123, or manager@blood.local / manager123 (Supabase Auth)"
            android:textSize="13sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="20dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Managers can manage all donors, stock and requests. Donors can view everything but only edit their own profile and donations."
            android:textSize="13sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</ScrollView>
