<?xml version="1.0" encoding="utf-8"?>
<!--
    Password recovery, in three steps that are really one screen:
      1. ask Supabase to send a 6-digit code by email;
      2. type the code and the new password;
      3. done — go and sign in.

    The steps are separate Views rather than separate Activities so the email
    address typed in step 1 cannot drift from the one the code is verified
    against in step 2.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reset your password" android:textSize="22sp"
            android:textStyle="bold" android:textColor="@color/text_accent" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the email address of your account and we will send you a 6-digit code."
            android:textSize="14sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp" android:layout_marginBottom="18dp" />

        <!-- STEP 1  -->
        <LinearLayout android:id="@+id/stepEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <EditText android:id="@+id/etEmail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Email address *"
                android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
            <Button android:id="@+id/btnSendCode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Send me a code"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- STEP 2  -->
        <LinearLayout android:id="@+id/stepCode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="The code is in the email we just sent. It is six digits, and it expires."
                android:textSize="13sp" android:textColor="@color/text_secondary"
                android:layout_marginBottom="10dp" />
            <EditText android:id="@+id/etCode" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="6-digit code *"
                android:inputType="number" android:maxLength="6"
                android:autofillHints="smsOTPCode" />
            <EditText android:id="@+id/etNewPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="New password *"
                android:inputType="textPassword" android:autofillHints="newPassword"
                android:layout_marginTop="8dp" />
            <EditText android:id="@+id/etConfirmPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Type the new password again *"
                android:inputType="textPassword" android:autofillHints="newPassword"
                android:layout_marginTop="8dp" />
            <Button android:id="@+id/btnSetPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Set a new password"
                android:layout_marginTop="14dp" />
            <Button android:id="@+id/btnResend" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Send the code again"
                android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <Button android:id="@+id/btnBackToLogin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Back to sign in"
            android:layout_marginTop="20dp" style="?attr/materialButtonOutlinedStyle" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="If no email arrives, check your spam folder, or ask the project owner to check the emails are turned on. The app cannot tell you whether an address exists — Supabase answers the same way either way, on purpose."
            android:textSize="12sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
