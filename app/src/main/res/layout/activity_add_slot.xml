<?xml version="1.0" encoding="utf-8"?>
<!-- Add slot form. Warm Clinical Sanguine restyle: titled header, labelled rounded fields, primary save. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Add Appointment Slot" android:textAppearance="@style/TextAppearance.Blood.Title"
            android:textColor="@color/text_accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Set the time and capacity for a donation slot"
            android:textAppearance="@style/TextAppearance.Blood.Secondary"
            android:layout_marginTop="2dp" android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Time" android:textAppearance="@style/TextAppearance.Blood.Label"
            android:layout_marginBottom="6dp" />
        <EditText android:id="@+id/etSlotTime" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/slot_time_hint"
            android:inputType="text" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Capacity" android:textAppearance="@style/TextAppearance.Blood.Label"
            android:layout_marginBottom="6dp" />
        <EditText android:id="@+id/etSlotCapacity" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/slot_capacity_hint"
            android:inputType="number" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Note" android:textAppearance="@style/TextAppearance.Blood.Label"
            android:layout_marginBottom="6dp" />
        <EditText android:id="@+id/etSlotNote" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/slot_note_hint"
            android:inputType="textCapSentences" android:layout_marginBottom="16dp" />

        <Button android:id="@+id/btnSaveSlot" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/label_save_slot" />
    </LinearLayout>
</ScrollView>
