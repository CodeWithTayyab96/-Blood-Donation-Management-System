<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard. Warm Clinical Sanguine: warm canvas, white 20dp cards, crimson actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <!-- Header: light, crimson drop tile, no gradient, no emoji. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile_crimson"
                android:padding="14dp"
                android:src="@drawable/ic_drop"
                android:contentDescription="Blood drop" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="@color/on_surface" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Every donation can save up to three lives."
                    android:textSize="14sp" android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Daily motivation card: one fact per day, stable for the day, the
             same on every device. No medical claims (see MotivationFacts). -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Did you know?" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/text_accent" />
                <TextView android:id="@+id/tvFact" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stat cards, 2 x 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Blood.Card"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile" android:padding="10dp"
                        android:src="@drawable/ic_stat_donors" app:tint="@color/brand_primary_container"
                        android:contentDescription="Donors" />
                    <TextView android:id="@+id/tvStatDonors" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textAppearance="@style/TextAppearance.Blood.Stat"
                        android:layout_marginTop="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Registered Donors" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Blood.Card"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile" android:padding="10dp"
                        android:src="@drawable/ic_stat_stock" app:tint="@color/brand_primary_container"
                        android:contentDescription="Stock" />
                    <TextView android:id="@+id/tvStatUnits" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textAppearance="@style/TextAppearance.Blood.Stat"
                        android:layout_marginTop="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Units in Stock" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Blood.Card"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile_amber" android:padding="10dp"
                        android:src="@drawable/ic_stat_requests"
                        android:contentDescription="Pending requests" />
                    <TextView android:id="@+id/tvStatRequests" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textAppearance="@style/TextAppearance.Blood.Stat"
                        android:layout_marginTop="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending Requests" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Blood.Card"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_icon_tile" android:padding="10dp"
                        android:src="@drawable/ic_stat_month" app:tint="@color/brand_primary_container"
                        android:contentDescription="Donated this month" />
                    <TextView android:id="@+id/tvStatMonth" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textAppearance="@style/TextAppearance.Blood.Stat"
                        android:layout_marginTop="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Units Donated This Month" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Urgent banner: shown only when pending requests exist (set in MainActivity). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUrgentBanner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:visibility="gone"
            android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="20dp" app:cardElevation="2dp"
            app:cardBackgroundColor="@color/brand_primary_container">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_urgent_icon_tile" android:padding="10dp"
                        android:src="@drawable/ic_stat_requests" app:tint="@color/white"
                        android:contentDescription="Urgent" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:id="@+id/tvUrgentBanner" android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Open Blood Requests to review and match donors."
                            android:textSize="14sp" android:textColor="#E8FFFFFF"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_white"
                    android:text="View requests" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/brand_primary_container" android:gravity="center"
                    android:paddingTop="12dp" android:paddingBottom="12dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Donor milestones, computed locally from the donation history. Shown
             only when the signed-in person has a donor profile; a manager with
             none never sees it. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMilestones"
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Your donation milestones" android:textSize="15sp"
                    android:textStyle="bold" android:textColor="@color/text_accent" />
                <TextView android:id="@+id/tvMilestones" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="14sp"
                    android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tvSignedIn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />

        <!-- Shown when the signed-in account has no Supabase session, which
             means every online call is anonymous and therefore rejected. -->
        <TextView android:id="@+id/tvSyncWarning" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/status_warn" android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <!-- Quick actions (existing button navigation, restyled) -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textAppearance="@style/TextAppearance.Blood.SectionTitle"
            android:layout_marginTop="20dp" android:layout_marginBottom="12dp" />

        <Button android:id="@+id/btnDonors" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Manage Donors" />
        <!-- Phase 3: blood camps, slots, forecast and offline emergency. -->
        <Button android:id="@+id/btnCamps" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_camps" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnSlots" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_slots" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnForecast" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_forecast" android:layout_marginTop="10dp"
            style="?attr/materialButtonOutlinedStyle" />
        <Button android:id="@+id/btnEmergency" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/nav_emergency" android:layout_marginTop="10dp"
            style="?attr/materialButtonOutlinedStyle" />
        <Button android:id="@+id/btnStock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Blood Stock" android:layout_marginTop="10dp"
            style="@style/Widget.Blood.Button.Secondary" />
        <Button android:id="@+id/btnRequests" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Blood Requests" android:layout_marginTop="10dp"
            style="@style/Widget.Blood.Button.Secondary" />
        <!-- P2P: managers only. MainActivity leaves this GONE for everyone else. -->
        <Button android:id="@+id/btnModeration" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Moderation - reports and offers" android:layout_marginTop="10dp"
            android:visibility="gone" />
        <Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="My Profile" android:layout_marginTop="10dp" />
        <!-- Phase 2: manager-only monthly CSV report. -->
        <Button android:id="@+id/btnManagerReport" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/label_manager_reports" android:layout_marginTop="10dp"
            style="?attr/materialButtonOutlinedStyle" />
        <!-- Phase 4 AI helper: open to every signed-in user. -->
        <Button android:id="@+id/btnAskDonate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Can I donate? (AI helper)" android:layout_marginTop="10dp"
            style="?attr/materialButtonOutlinedStyle" />
        <Button android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Settings" android:layout_marginTop="10dp" style="?attr/materialButtonOutlinedStyle" />
        <Button android:id="@+id/btnUpdate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Check for Updates" android:layout_marginTop="10dp" />
        <!-- Debug builds only. MainActivity leaves this GONE in release builds. -->
        <Button android:id="@+id/btnCheckRequests" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Check requests now (debug only)"
            android:layout_marginTop="10dp" android:visibility="gone" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log Out" android:layout_marginTop="10dp" style="?attr/materialButtonOutlinedStyle" />

        <!-- Stock by blood group (live summary text, bound in MainActivity) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Blood.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stock by blood group"
                        android:textAppearance="@style/TextAppearance.Blood.SectionTitle" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_rose"
                        android:text="Live Inventory" android:textSize="11sp" android:textStyle="bold"
                        android:textColor="@color/brand_primary_container"
                        android:paddingTop="6dp" android:paddingBottom="6dp"
                        android:paddingStart="12dp" android:paddingEnd="12dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvStockSummary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="15sp"
                    android:textColor="@color/on_surface" android:lineSpacingMultiplier="1.3"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- In-flight sync indicator: shown while the dashboard pulls donors, requests and stock. -->
        <LinearLayout android:id="@+id/syncRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="8dp" android:visibility="gone">
            <ProgressBar android:id="@+id/progressSync"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleSmall" android:indeterminate="true" />
            <TextView android:id="@+id/syncLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
