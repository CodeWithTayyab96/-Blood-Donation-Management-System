<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/blood_red_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🩸 Blood Donation Management" android:textSize="22sp"
            android:textStyle="bold" android:textColor="@color/blood_red_dark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Every donation can save up to three lives."
            android:textSize="14sp" android:textColor="@color/grey_text"
            android:layout_marginBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" app:cardCornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvStatDonors" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="26sp"
                        android:textStyle="bold" android:textColor="@color/blood_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Registered Donors" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvStatUnits" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="26sp"
                        android:textStyle="bold" android:textColor="@color/blood_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Units in Stock" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvStatRequests" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="26sp"
                        android:textStyle="bold" android:textColor="@color/blood_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pending Requests" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" app:cardCornerRadius="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tvStatMonth" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="26sp"
                        android:textStyle="bold" android:textColor="@color/blood_red" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Units Donated This Month" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView android:id="@+id/tvSignedIn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/grey_text" android:layout_marginBottom="4dp" />

        <!-- Shown when the signed-in account has no Supabase session, which
             means every online call is anonymous and therefore rejected. -->
        <TextView android:id="@+id/tvSyncWarning" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="@color/orange_warn" android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <Button android:id="@+id/btnDonors" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="👥  Manage Donors" android:layout_marginTop="20dp" />
        <Button android:id="@+id/btnStock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🏥  Blood Stock" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnRequests" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📋  Blood Requests" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnProfile" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="👤  My Profile" android:layout_marginTop="10dp" />
        <Button android:id="@+id/btnUpdate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⬇  Check for Updates" android:layout_marginTop="10dp" />
        <!-- Debug builds only. MainActivity leaves this GONE in release builds. -->
        <Button android:id="@+id/btnCheckRequests" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Check requests now (debug only)"
            android:layout_marginTop="10dp" android:visibility="gone" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Log Out" android:layout_marginTop="10dp" style="?attr/materialButtonOutlinedStyle" />

        <!--
            Explicit text colours: the page background is a fixed light pink
            (@color/blood_red_light) in both light and dark mode, but the theme
            is DayNight, so anything without a colour inherits white in dark
            mode and disappears against it.
        -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Stock by blood group" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/grey_text"
            android:layout_marginTop="22dp" android:layout_marginBottom="6dp" />
        <TextView android:id="@+id/tvStockSummary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="15sp"
            android:textColor="@color/grey_text" android:lineSpacingMultiplier="1.3" />
    </LinearLayout>
</ScrollView>
