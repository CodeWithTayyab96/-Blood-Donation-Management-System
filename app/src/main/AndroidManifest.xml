<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by the in-app updater: check GitHub Releases, then download the new APK. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed on Android 8+ so the system installer can open an APK this app downloaded. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Urgent-request alerts. Runtime permission on Android 13+; without it the
         notifications are silently dropped, so MainActivity asks for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup is OFF: the session store holds Supabase refresh tokens and
        the offline password hash, and a cloud backup or adb backup would copy
        them off the device. dataExtractionRules repeats the exclusion for
        Android 12+, where allowBackup no longer covers device-to-device
        transfer on its own.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher_drop"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BloodDonation">

        <!-- Lets the system installer read the APK file this app downloaded into its cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Phase 4 AI helper. Anything may open it; only the fact fields
             described in its layout ever leave the phone. -->
        <activity android:name=".ui.AskDonateActivity" android:exported="false" />
        <activity android:name=".ui.RequestDetailActivity" android:exported="false" />
        <activity android:name=".ui.AddRequestActivity" android:exported="false" />
        <activity android:name=".ui.CreateRequestActivity" android:exported="false" />
        <activity android:name=".ui.ModerationActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.RequestListActivity" android:exported="false" />
        <activity android:name=".ui.StockActivity" android:exported="false" />
        <activity android:name=".ui.DonorDetailActivity" android:exported="false" />
        <activity android:name=".ui.AddDonorActivity" android:exported="false" />
        <activity android:name=".ui.DonorListActivity" android:exported="false" />
        <activity android:name=".ui.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 3 push notifications, started only by the Firebase SDK.
             With no Firebase values baked into the build the app never
             initialises Firebase, so this service is never created and the
             WorkManager poll keeps alerting as before. -->
        <service
            android:name=".util.BloodMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_SERVICE" />
            </intent-filter>
        </service>
    </application>
</manifest>
